# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)

# ---------- Database (PostgreSQL) ----------
# Option A: single connection string (takes precedence when set)
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipt_school

# Option B: individual variables
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=ipt_school

# ---------- Server ----------
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
SUPERADMIN_SETUP_PASSWORD=ganti_dengan_password_awal_rahasia
NODE_ENV=development
PORT=5000
# Comma-separated origins allowed to call the API in production.
# When exposing via Cloudflare Tunnel, add the tunnel URL here, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://abc-def.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:3000
# Set TRUST_PROXY=1 in production ONLY if behind a reverse proxy (nginx, etc.),
# otherwise clients could spoof IPs to bypass rate limiting.
# REQUIRED when running behind Cloudflare Tunnel (or any proxy): without it
# every visitor looks like 127.0.0.1 and shares one rate-limit budget.
#TRUST_PROXY=1

# ---------- Monitoring (Prometheus) ----------
# Bearer token guarding GET /metrics. Prometheus scrapes with
# `bearer_token: <same value>` in scrape_config. When unset, /metrics is open.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#METRICS_TOKEN=isi_dengan_token_acak_minimal_32_karakter

# ---------- Login pertama (PENTING) ----------
# Database baru berisi akun ADMIN001 dengan password placeholder.
# Login pertama dengan username ADMIN001 dan password = nilai
# SUPERADMIN_SETUP_PASSWORD di atas. Password otomatis di-hash saat login.
# Segera ganti password lewat menu Profile, lalu hapus variabel itu dari .env.
