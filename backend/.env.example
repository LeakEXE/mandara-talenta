# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)

# ---------- Database (PostgreSQL) ----------
# Option A: single connection string (takes precedence when set)
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipt_school

# Option B: individual variables
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=ipt_school

# ---------- Server ----------
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
SUPERADMIN_SETUP_PASSWORD=ganti_dengan_password_awal_rahasia
NODE_ENV=development
PORT=5000
# Comma-separated exact origins allowed to call the API in production.
# In production only https:// origins are used; the public origin is always
# included. Do not use wildcards.
ALLOWED_ORIGINS=https://talenta.skanbara.my.id
# Cloudflare Tunnel runs on a separate LAN host and connects to this server via
# its LAN IP. Listen on a reachable interface: the server's LAN IP is preferred,
# 0.0.0.0 works but listens on every interface. Firewall ports 3000/5000 so only
# the cloudflared host can connect. Use 127.0.0.1 only for local development
# without a remote tunnel.
HOST=0.0.0.0
# cloudflared is the only trusted proxy hop. Keep this at 1 while the origin is
# reachable only from the cloudflared host; otherwise LAN clients could spoof
# X-Forwarded-For and bypass IP-based rate limiting.
TRUST_PROXY=1

# ---------- hCaptcha (wajib untuk login) ----------
# Buat akun di https://dashboard.hcaptcha.com, lalu salin sitekey dan secret.
# Sitekey yang sama juga dipakai frontend sebagai
# REACT_APP_HCAPTCHA_SITE_KEY saat build.
# Jangan pernah menaruh secret di frontend atau commit ke git.
# Test key resmi hCaptcha (sitekey 10000000-... / secret 0x000...) ditolak
# otomatis saat NODE_ENV=production.
HCAPTCHA_SITE_KEY=isi_sitekey_hcaptcha
HCAPTCHA_SECRET_KEY=isi_secret_hcaptcha
# Opsional: batas waktu verifikasi ke hCaptcha (1000-15000 ms, default 5000).
#HCAPTCHA_TIMEOUT_MS=5000

# ---------- Monitoring (Prometheus) ----------
# Bearer token guarding GET /metrics. Prometheus scrapes with
# `bearer_token: <same value>` in scrape_config. When unset, /metrics is open.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#METRICS_TOKEN=isi_dengan_token_acak_minimal_32_karakter

# ---------- Login pertama (PENTING) ----------
# Database baru berisi akun ADMIN001 dengan password placeholder.
# Login pertama dengan username ADMIN001 dan password = nilai
# SUPERADMIN_SETUP_PASSWORD di atas. Password otomatis di-hash saat login.
# Segera ganti password lewat menu Profile, lalu hapus variabel itu dari .env.
