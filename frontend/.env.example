# Public hCaptcha sitekey. This value is embedded into the React build.
# Use the same sitekey as HCAPTCHA_SITE_KEY in backend/.env.
# Keep the hCaptcha SECRET on the backend only.
#
# For local development hCaptcha rejects localhost/127.0.0.1. Add a hosts
# entry (for example: 127.0.0.1 test.mydomain.com) and open the app through
# that hostname, or use hCaptcha's test sitekey in a disposable test build.
REACT_APP_HCAPTCHA_SITE_KEY=isi_sitekey_hcaptcha
